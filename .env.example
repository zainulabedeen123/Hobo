# Server-only: pulled by Neon CLI. Never expose these through VITE_ variables.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Browser-safe public endpoints.
VITE_NEON_AUTH_URL=
VITE_TASK_API_URL=

# Comma-separated public web origins allowed to call the task API.
APP_ORIGINS=http://localhost:1420
